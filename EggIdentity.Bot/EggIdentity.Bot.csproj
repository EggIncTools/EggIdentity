<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Discord bot spine for eggidentity: verify, updateserver, embeds.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Contract\EggIdentity.Contract.csproj" />
    <ProjectReference Include="..\EggIdentity.Db\EggIdentity.Db.csproj" />
    <ProjectReference Include="..\EggIdentity.Config\EggIdentity.Config.csproj" />
    <ProjectReference Include="..\EggIdentity.Auth\EggIdentity.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Migrations\*.up.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
