<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Vendored Lucide and Simple Icons svg pack behind EggIdentity.UI.Icon. Dependency-free.</Description>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSE-THIRD-PARTY.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Vendor\lucide\*.svg" LogicalName="lucide/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Vendor\simple-icons\*.svg" LogicalName="simple-icons/%(Filename)%(Extension)" />
    <None Include="Vendor\lucide\LICENSE" Pack="true" PackagePath="licenses/lucide/" />
    <None Include="Vendor\simple-icons\LICENSE" Pack="true" PackagePath="licenses/simple-icons/" />
    <None Include="LICENSE-THIRD-PARTY.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.Icons.Tests" />
  </ItemGroup>

</Project>
