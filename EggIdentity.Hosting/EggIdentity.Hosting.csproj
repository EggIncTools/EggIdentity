<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Hosted-service primitives for eggidentity apps: a periodic background service that runs each tick in its own DI scope on an injected TimeProvider, logs and continues on failure.</Description>
