@page "/admin"
@using EggIdentity.Auth
@using EggIdentity.Contract
@inject NavigationManager Nav
@rendermode @(RenderMode.InteractiveServer)

<PageTitle>EggIdentity admin</PageTitle>

@if (_isAdmin) {
    <MessageConfigEditor/>
    <h2>Settings</h2>
    <SettingsPanel UpdatedBy="@_userId"/>
} else if (_checked) {
    <p>Admin access required. <a href="@_loginUrl">Log in</a></p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private bool _isAdmin;
    private bool _checked;
    private string _loginUrl = "";
    private string? _userId;

    protected override async Task OnInitializedAsync() {
        var returnUrl = Uri.EscapeDataString(Nav.ToAbsoluteUri("/admin").ToString());
        _loginUrl = $"/auth/go/discord?returnUrl={returnUrl}&mode=redirect";

        if (AuthStateTask is not null) {
            var state = await AuthStateTask;
            _isAdmin = state.User.IsAtLeast(UserRole.Admin);
            _userId = state.User.FindFirst("sub")?.Value;
        }

        _checked = true;
    }

}
