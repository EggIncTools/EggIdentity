<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Identity host: bearer-gated identity API, SSO issuer, login widget, and the suite admin API with fleet control over Portainer.</Description>
    <RootNamespace>EggIdentity.Host</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity\EggIdentity.csproj" />
    <ProjectReference Include="..\EggIdentity.Bot\EggIdentity.Bot.csproj" />
    <ProjectReference Include="..\EggIdentity.Brand\EggIdentity.Brand.csproj" />
    <ProjectReference Include="..\EggIdentity.Web\EggIdentity.Web.csproj" />
    <ProjectReference Include="..\EggIdentity.Admin\EggIdentity.Admin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\EggIdentity\Migrations\*.up.sql" Link="Migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EggIdentity.Bot\Migrations\*.up.sql" Link="BotMigrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
