<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EggIdentity</RootNamespace>
    <Description>EggIdentity data: Postgres init and the numbered .up.sql migration runner (Db), the Postgres settings store with secret protection and LISTEN/NOTIFY propagation (Settings.Store), and the prod-to-subprod database clone (DbClone).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Core\EggIdentity.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Settings.Store\Migrations\*.up.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.Data.Tests" />
  </ItemGroup>

</Project>
