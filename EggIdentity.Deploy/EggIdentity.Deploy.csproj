<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Consumer-side client for eggidentity-agent: typed agent calls, SSE deploy-event listener, agent-backed env source and restart trigger, plus the deploy.apps settings collection shared by the agent and the admin UI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Contract\EggIdentity.Contract.csproj" />
    <ProjectReference Include="..\EggIdentity.Auth\EggIdentity.Auth.csproj" />
    <ProjectReference Include="..\EggIdentity.Settings\EggIdentity.Settings.csproj" />
    <ProjectReference Include="..\EggIdentity.Resilience\EggIdentity.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.Deploy.Tests" />
  </ItemGroup>

</Project>
