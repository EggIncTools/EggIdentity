<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EggIdentity</RootNamespace>
    <Description>EggIdentity UI: shared Blazor components (UI), the shared component stylesheet shipped as _content/EggIdentity.UI/shared.css plus the CssSheet parser and theming model (Styles), and the vendored Lucide and Simple Icons pack (Icons).</Description>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageLicenseFile>LICENSE-THIRD-PARTY.txt</PackageLicenseFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Core\EggIdentity.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\Vendor\lucide\*.svg" LogicalName="lucide/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Icons\Vendor\simple-icons\*.svg" LogicalName="simple-icons/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Icons\LICENSE-THIRD-PARTY.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.UI.Tests" />
  </ItemGroup>

</Project>
