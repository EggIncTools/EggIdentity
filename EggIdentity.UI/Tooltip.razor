<span class="@TriggerCss" style="--tt-anchor: --@_id" tabindex="@(Focusable ? "0" : null)" aria-describedby="@_id"
      @onkeydown="OnKeyDown" @onmouseleave="Rearm" @onfocusout="Rearm">@ChildContent<span id="@_id" role="tooltip" class="@PopCss">@if (Content is not null) {
            @Content
        } else {
            @Text
        }</span></span>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? PopClass { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Focusable { get; set; }

    readonly string _id = "tt-" + Guid.NewGuid().ToString("N");
    bool _dismissed;

    string TriggerCss {
        get {
            var css = _dismissed ? "tooltip-trigger tt-dismissed" : "tooltip-trigger";
            return string.IsNullOrEmpty(Class) ? css : $"{css} {Class}";
        }
    }

    string PopCss {
        get {
            var css = Error ? "tooltip-floating tooltip-fixed tooltip-toggle tooltip-err" : "tooltip-floating tooltip-fixed tooltip-toggle";
            return string.IsNullOrEmpty(PopClass) ? css : $"{css} {PopClass}";
        }
    }

    void OnKeyDown(KeyboardEventArgs e) => _dismissed |= e.Key == "Escape";

    void Rearm() => _dismissed = false;
}
