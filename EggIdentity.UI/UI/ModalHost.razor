
@if (Open && !UseNativeDialog) {
    <div class="modal-backdrop" @ref="_root" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@TitleId"
         @onkeydown="HandleKeyDown" @onkeydown:preventDefault="PreventKeyDefault" @onclick="OnBackdropClick">
        <span class="modal-sentinel" tabindex="0" @onfocus="() => _card.FocusAsync()" aria-hidden="true"></span>
        <div class="@CardCss" tabindex="-1" @ref="_card" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3 class="modal-title" id="@TitleId">@Title</h3>
                @HeadTools
                @if (!HideClose) {
                    <button type="button" class="icon-btn" aria-label="Close" @onclick="OnClose">
                        <Icon Name="close"/>
                    </button>
                }
            </div>
            @ChildContent
        </div>
        <span class="modal-sentinel" tabindex="0" @onfocus="() => _card.FocusAsync()" aria-hidden="true"></span>
    </div>
}
@if (Open && UseNativeDialog) {
    <dialog class="modal-backdrop" @ref="_root" tabindex="-1" open aria-labelledby="@TitleId"
            @onkeydown="HandleKeyDown" @onkeydown:preventDefault="PreventKeyDefault" @onclick="OnBackdropClick">
        <span class="modal-sentinel" tabindex="0" @onfocus="() => _card.FocusAsync()" aria-hidden="true"></span>
        <div class="@CardCss" tabindex="-1" @ref="_card" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3 class="modal-title" id="@TitleId">@Title</h3>
                @HeadTools
                @if (!HideClose) {
                    <button type="button" class="icon-btn" aria-label="Close" @onclick="OnClose">
                        <Icon Name="close"/>
                    </button>
                }
            </div>
            @ChildContent
        </div>
        <span class="modal-sentinel" tabindex="0" @onfocus="() => _card.FocusAsync()" aria-hidden="true"></span>
    </dialog>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? TitleId { get; set; }
    [Parameter] public string? CardClass { get; set; }
    [Parameter] public ModalWidth Width { get; set; } = ModalWidth.Regular;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool HideClose { get; set; }
    [Parameter] public bool UseNativeDialog { get; set; }
    [Parameter] public bool PreventKeyDefault { get; set; }
    [Parameter] public ElementReference? ReturnFocusTo { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public RenderFragment? HeadTools { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    ElementReference _root;
    ElementReference _card;
    bool _wasOpen;
    bool _pendingFocus;
    bool _pendingReturn;

    string CardCss {
        get {
            var css = "modal-card" + Width switch {
                ModalWidth.Small => " modal-card-sm",
                ModalWidth.Large => " modal-card-lg",
                _ => ""
            };
            return string.IsNullOrEmpty(CardClass) ? css : $"{css} {CardClass}";
        }
    }

    protected override void OnParametersSet() {
        if (Open && !_wasOpen) _pendingFocus = true;
        if (!Open && _wasOpen) _pendingReturn = true;
        _wasOpen = Open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_pendingFocus) {
            _pendingFocus = false;
            await _root.FocusAsync();
        }
        if (_pendingReturn) {
            _pendingReturn = false;
            if (ReturnFocusTo is { } opener) await opener.FocusAsync();
        }
    }

    Task OnBackdropClick() => CloseOnBackdrop ? OnClose.InvokeAsync() : Task.CompletedTask;

    Task HandleKeyDown(KeyboardEventArgs e) =>
        CloseOnEscape && e.Key == "Escape" ? OnClose.InvokeAsync() : OnKeyDown.InvokeAsync(e);
}
