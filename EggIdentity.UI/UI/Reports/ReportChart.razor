@using System.Diagnostics.CodeAnalysis

@if (ComponentType is not null) {
    @Chart
} else {
    <div class="report-note">@Context.Labels.UnknownChart</div>
}

@code {
    [Parameter, EditorRequired] public ChartContext Context { get; set; } = null!;
    [Parameter] public ReportRenderers? Renderers { get; set; }

    [DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.All)]
    private Type? ComponentType => (Renderers ?? ReportRenderers.Default).Find(Context.Definition.View.Chart);

    private RenderFragment Chart => builder => {
        builder.OpenComponent(0, ComponentType!);
        builder.AddComponentParameter(1, "Context", Context);
        builder.CloseComponent();
    };
}
