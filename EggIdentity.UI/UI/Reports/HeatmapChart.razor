@using System.Globalization
@using EggIdentity.Reports
@using EggIdentity.UI

@if (_layout is not { } layout || _valueMatrix is not { } valueMatrix) {
    <div class="report-note">@Context.Labels.NoData</div>
} else {
    var columns = LabeledColumns(layout);
    <div class="report-chart">
        <div class="report-heat-wrap">
            <table class="report-heat">
                <thead>
                <tr>
                    <th class="report-heat-corner"></th>
                    @foreach (var col in columns) {
                        <th class="report-heat-col"><Tooltip Class="report-trunc" Text="@col">@col</Tooltip></th>
                    }
                </tr>
                </thead>
                <tbody>
                @for (var r = 0; r < layout.RowKeys.Count; r++) {
                    var rowLabel = LabelFor(layout.RowKeys[r], layout.RowLabels[r]);
                    <tr>
                        <th class="report-heat-row"><Tooltip Class="report-trunc" Text="@rowLabel">@rowLabel</Tooltip></th>
                        @for (var c = 0; c < layout.ColKeys.Count; c++) {
                            var cell = layout.Cells[r][c];
                            if (cell.Hidden) {
                                <td class="report-heat-cell"></td>
                            } else {
                                var value = valueMatrix.Cells[r][c];
                                var colLabel = columns[c];
                                double? secondary = _secondaryMatrix is { } secondaryMatrix && !Below(cell) ? secondaryMatrix.Cells[r][c] : null;
                                <td class="@CellClass(cell, value)" style="@CellStyle(cell)">
                                    <Tooltip Tag="div" Lines="@CellLines(rowLabel, colLabel, cell, value)">
                                        <span>@Display(cell, value)</span>
                                        @if (secondary is { } sv) {
                                            <span class="report-heat-secondary">@FormatSecondary(sv)</span>
                                        }
                                    </Tooltip>
                                </td>
                            }
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (!string.IsNullOrEmpty(Context.Definition.View.Unit)) {
            <div class="report-unit">@Context.Definition.View.Unit</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ChartContext Context { get; set; } = null!;

    private ReportMatrix? _valueMatrix;
    private ReportMatrix? _secondaryMatrix;
    private string? _secondaryKey;
    private HeatmapLayout? _layout;

    private string MeasureKey => Context.Cube.Measures.Count > 0 ? Context.Cube.Measures[0].Key : MeasureRequest.RowCountKey;

    private HeatView? Heat => Context.Definition.View.Heat;

    private NormalizeKind ScaleKind {
        get {
            var heat = Heat;
            if (heat?.ColorBy is not null && heat.Scale == HeatScale.Auto) {
                return NormalizeKind.By;
            }
            return (heat?.Scale ?? HeatScale.Auto) switch {
                HeatScale.Ratio => NormalizeKind.By,
                HeatScale.Relative => NormalizeKind.None,
                _ => Context.Definition.Query.Normalize.Kind
            };
        }
    }

    protected override void OnParametersSet() {
        if (Context.Cube.Dimensions.Count < 2) {
            _valueMatrix = null;
            _secondaryMatrix = null;
            _secondaryKey = null;
            _layout = null;
            return;
        }

        var rowDim = Context.Cube.Dimensions[0];
        var colDim = Context.Cube.Dimensions[1];
        var view = Context.Definition.View;

        _valueMatrix = ReportProjection.Matrix(Context.Cube, MeasureKey, rowDim, colDim, Context.Source);

        var colorBy = view.Heat?.ColorBy;
        var colorMatrix = colorBy is not null && Context.Cube.MeasureIndex(colorBy) >= 0
            ? ReportProjection.Matrix(Context.Cube, colorBy, rowDim, colDim, Context.Source)
            : _valueMatrix;

        var secondaryBy = view.Heat?.SecondaryBy;
        if (secondaryBy is not null && Context.Cube.MeasureIndex(secondaryBy) >= 0) {
            _secondaryMatrix = ReportProjection.Matrix(Context.Cube, secondaryBy, rowDim, colDim, Context.Source);
            _secondaryKey = secondaryBy;
        } else {
            _secondaryMatrix = null;
            _secondaryKey = null;
        }

        _layout = HeatmapGeometry.Layout(colorMatrix, ScaleKind, Context.Definition.Query.MinSample, view.Sample, Context.Style, _valueMatrix);
    }

    private IReadOnlyList<string> LabeledColumns(HeatmapLayout layout) => [.. layout.ColKeys.Select((k, i) => LabelFor(k, layout.ColLabels[i]))];

    private string LabelFor(string key, string fallback) =>
        Context.Definition.View.Labels.TryGetValue(key, out var custom) ? custom : fallback;

    private bool Below(HeatCell cell) => Context.Definition.View.Sample != SampleRule.Show && ReportProjection.BelowSample(cell.Samples, Context.Definition.Query.MinSample);

    private bool Zero(HeatCell cell, double? value) => Below(cell) || (value ?? 0) == 0;

    private string CellClass(HeatCell cell, double? value) {
        var cls = "report-heat-cell";
        if (Zero(cell, value)) {
            cls += " report-heat-zero";
        }
        if (Below(cell)) {
            cls += " report-dim";
        }
        return cls;
    }

    private string CellStyle(HeatCell cell) {
        var view = Context.Definition.View;
        string? unfilled = null;
        if (view.Unfilled is { } u && ReportCodec.IsHex(u)) {
            unfilled = u;
        } else if (Context.Style.HeatLow is { } hl && ReportCodec.IsHex(hl)) {
            unfilled = hl;
        }

        string? color = null;
        if (view.Color is { } c && ReportCodec.IsHex(c)) {
            color = c;
        } else if (Context.Style.HeatHigh is { } hh && ReportCodec.IsHex(hh)) {
            color = hh;
        }

        var style = string.Create(CultureInfo.InvariantCulture, $"--heat:{cell.Intensity:0.###}");

        if (unfilled is not null) {
            style += $";--unfilled:{unfilled}";
        }

        if (color is not null) {
            style += $";--heat-high:{color}";
        }

        if (cell.Intensity == 0) {
            return unfilled is not null && HeatmapGeometry.IsLight(unfilled, Context.Style) ? style + $";--heat-fg:{DarkFg}" : style;
        }

        if (unfilled is not null && color is not null && HeatmapGeometry.Mix(unfilled, color, cell.Intensity) is { } mixed) {
            return style + $";--heat-fg:{(HeatmapGeometry.IsLight(mixed, Context.Style) ? DarkFg : LightFg)}";
        }

        if (cell.Intensity >= Context.Style.HeatStrongAt) {
            style += ";--heat-fg:var(--report-heat-fg-strong,var(--color-bg))";
        }

        return style;
    }

    private string Display(HeatCell cell, double? value) {
        if (Below(cell)) {
            return "-";
        }
        if (Heat?.Scale == HeatScale.Ratio) {
            return value is { } v && v != 0 ? "x" + v.ToString("0.00", CultureInfo.InvariantCulture) : "-";
        }
        return Context.Compact(MeasureKey, value ?? 0);
    }

    private const string DarkFg = "var(--report-heat-fg-dark,var(--color-bg))";
    private const string LightFg = "var(--report-heat-fg-light,var(--color-fg))";

    private List<TooltipLine> CellLines(string rowLabel, string colLabel, HeatCell cell, double? value) =>
        [new TooltipLine(rowLabel, Head: true), new TooltipLine($"{colLabel}: {Display(cell, value)}")];

    private string FormatSecondary(double value) => Context.Compact(_secondaryKey ?? MeasureRequest.RowCountKey, value);
}
