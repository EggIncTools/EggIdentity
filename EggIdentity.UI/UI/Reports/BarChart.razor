@using System.Globalization
@using EggIdentity.Reports

@if (Context.Cube.Rows.Count == 0) {
    <div class="report-note">@Context.Labels.NoData</div>
} else {
    <div class="report-chart" style="@UnfilledStyle">
        <div class="report-bars report-marks">
            @foreach (var bar in Bars) {
                var dim = Dimmed(bar);
                var label = Context.Label(bar.Key, bar.Label);
                <div class="@RowClass(dim)">
                    <Tooltip Class="report-bar-label" Text="@label">@label</Tooltip>
                    <span class="report-bar-track"><Tooltip Class="report-bar-fill report-mark" Style="@FillStyle(bar)" Lines="@BarLines(bar)"/></span>
                    <span class="report-bar-value">@FormatValue(bar.Value)</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Context.Definition.View.Unit)) {
                <div class="report-unit">@Context.Definition.View.Unit</div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ChartContext Context { get; set; } = null!;

    private IReadOnlyList<BarItem> Bars = [];
    private IReadOnlyDictionary<string, string> _styles = new Dictionary<string, string>(StringComparer.Ordinal);

    private string MeasureKey => Context.Cube.Measures.Count > 0 ? Context.Cube.Measures[0].Key : MeasureRequest.RowCountKey;

    private BarOrder Order {
        get {
            var match = Context.Definition.Query.Sort.FirstOrDefault(s => string.Equals(s.Key, MeasureKey, StringComparison.Ordinal));
            if (match is null) {
                return BarOrder.Natural;
            }
            return match.Descending ? BarOrder.Descending : BarOrder.Ascending;
        }
    }

    protected override void OnParametersSet() {
        var series = ReportProjection.Series(Context.Cube, MeasureKey, Context.Source);
        var items = BarGeometry.Bars(series, Order);
        var hide = Context.Definition.View.Sample == SampleRule.Hide;
        Bars = [.. items.Where(b => !hide || !ReportProjection.BelowSample(b.Samples, Context.Definition.Query.MinSample))];
        _styles = Context.SeriesStyles([.. Bars.Select(b => b.Key)]);
    }

    private string UnfilledStyle =>
        Context.Definition.View.Unfilled is { } hex && ReportCodec.IsHex(hex) ? $"--unfilled:{hex}" : "";

    private bool Dimmed(BarItem bar) =>
        Context.Definition.View.Sample == SampleRule.Dim && ReportProjection.BelowSample(bar.Samples, Context.Definition.Query.MinSample);

    private static string RowClass(bool dim) => dim ? "report-bar report-dim" : "report-bar";

    private string FillStyle(BarItem bar) =>
        string.Create(CultureInfo.InvariantCulture, $"width:{bar.Width:0.###}%;{SeriesStyle(bar.Key)}");

    private string SeriesStyle(string key) => _styles.GetValueOrDefault(key, "");

    private IReadOnlyList<TooltipLine> BarLines(BarItem bar) {
        var label = Context.Label(bar.Key, bar.Label);
        var unit = Context.Definition.View.Unit;
        var unitSuffix = string.IsNullOrEmpty(unit) ? "" : $" {unit}";
        return [new TooltipLine(label, Head: true), new TooltipLine(FormatValue(bar.Value) + unitSuffix)];
    }

    private string FormatValue(double value) => Context.Format(MeasureKey).Format(value);
}
