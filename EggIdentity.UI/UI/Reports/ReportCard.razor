@using EggIdentity.Reports
@using EggIdentity.UI

<div class="report-card">
    <div class="report-card-head">
        <div class="report-card-titles">
            <div class="report-card-title">@Definition.Title</div>
            @if (!string.IsNullOrEmpty(Definition.Description)) {
                <div class="report-card-desc">@Definition.Description</div>
            }
        </div>
        @if (ShowChartSwitch || ShowNumberSwitch) {
            <div class="report-card-switch">
                @if (ShowChartSwitch) {
                    <Segmented T="string" Options="ChartOptions" Selected="Definition.View.Chart" SelectedChanged="OnChartChanged" AriaLabel="Chart type"/>
                }
                @if (ShowNumberSwitch) {
                    <Segmented T="ReportNumberFormat" Options="NumberOptions" Selected="NumberFormat ?? ReportNumberFormat.Full"
                               SelectedChanged="OnNumberFormatChanged" AriaLabel="Number format"/>
                }
            </div>
        }
        @if (Actions is not null) {
            <div class="report-card-actions">@Actions</div>
        }
    </div>
    <div class="report-card-body">
        @if (Loading) {
            <div class="report-note">@ChartLabels.Running</div>
        } else if (Error is not null) {
            <div class="report-note report-note-err" role="alert">@Error</div>
        } else if (Cube is null || Cube.Rows.Count == 0) {
            <div class="report-note">@ChartLabels.NoData</div>
        } else if (Body is not null) {
            @Body(BuildContext())
        } else {
            <ReportChart Context="BuildContext()" Renderers="Renderers"/>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ReportDefinition Definition { get; set; } = null!;
    [Parameter] public ReportCube? Cube { get; set; }
    [Parameter] public IReportSource? Source { get; set; }
    [Parameter] public ChartStyle? Style { get; set; }
    [Parameter] public ReportLabels? Labels { get; set; }
    [Parameter] public ReportRenderers? Renderers { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment<ChartContext>? Body { get; set; }

    [Parameter] public IReadOnlyList<string>? ChartChoices { get; set; }
    [Parameter] public EventCallback<string> OnChartChanged { get; set; }
    [Parameter] public ReportNumberFormat? NumberFormat { get; set; }
    [Parameter] public EventCallback<ReportNumberFormat> OnNumberFormatChanged { get; set; }

    private bool ShowChartSwitch => ChartChoices is { Count: > 1 } && OnChartChanged.HasDelegate;

    private bool ShowNumberSwitch => OnNumberFormatChanged.HasDelegate;

    private IReadOnlyList<SegmentedOption<string>> ChartOptions =>
        [.. ChartChoices!.Select(c => new SegmentedOption<string>(c, ChartLabel(c), Title: ChartLabel(c), Icon: ChartIcon(c)))];

    public static string ChartIcon(string chart) => chart switch {
        ReportCharts.Bar => "chart-bar",
        ReportCharts.Pie => "chart-pie",
        ReportCharts.Line => "chart-line",
        ReportCharts.GroupedBar => "chart-column-big",
        ReportCharts.MultiLine => "chart-spline",
        ReportCharts.Heatmap => "layout-grid",
        _ => "table",
    };

    private static readonly IReadOnlyList<SegmentedOption<ReportNumberFormat>> NumberOptions = [
        new(ReportNumberFormat.Full, "123,456"),
        new(ReportNumberFormat.Compact, "123k"),
    ];

    public static string ChartLabel(string chart) => chart switch {
        ReportCharts.Bar => "Bar",
        ReportCharts.Pie => "Pie",
        ReportCharts.Line => "Line",
        ReportCharts.GroupedBar => "Grouped",
        ReportCharts.MultiLine => "Lines",
        ReportCharts.Heatmap => "Heat",
        ReportCharts.Table => "Table",
        _ => chart,
    };

    private ReportLabels ChartLabels => Labels ?? ReportLabels.Default;

    private ChartContext BuildContext() =>
        new(Cube!, NumberFormat is { } format ? Definition with { View = Definition.View with { NumberFormat = format } } : Definition,
            Source, Style ?? ChartStyle.Default, ChartLabels);
}
