@using System.Globalization
@using EggIdentity.Reports

@if (Context.Cube.Dimensions.Count < 2) {
    <EmptyState Title="@Context.Labels.EmptyTitle" Hint="@Context.Labels.EmptyDescription"/>
} else {
    <div class="report-chart">
        <div class="report-groups">
            @foreach (var row in Layout.Rows) {
                <div class="report-group">
                    <span class="report-bar-label">@LabelFor(row.Key, row.Label)</span>
                    <div class="report-group-bars">
                        @foreach (var cell in CellsFor(row)) {
                            <div class="@RowClass(Dimmed(cell))" title="@($"{LabelFor(cell.ColKey, ColLabel(cell.ColKey))} {FormatValue(cell.Value)}")">
                                <span class="report-bar-track"><span class="report-bar-fill" style="@FillStyle(cell)"></span></span>
                                <span class="report-bar-value">@FormatValue(cell.Value)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="report-legend">
            @foreach (var key in Layout.ColKeys) {
                <span class="report-legend-item">
                    <span class="report-legend-swatch" style="@SeriesStyle(key)"></span>
                    <span class="report-slice-label">@LabelFor(key, ColLabel(key))</span>
                </span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Context.Definition.View.Unit)) {
            <div class="report-unit">@Context.Definition.View.Unit</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ChartContext Context { get; set; } = null!;

    private ReportMatrix Matrix = null!;
    private GroupedBarLayout Layout = null!;
    private IReadOnlyDictionary<string, string> _styles = new Dictionary<string, string>(StringComparer.Ordinal);

    private string MeasureKey => Context.Cube.Measures.Count > 0 ? Context.Cube.Measures[0].Key : MeasureRequest.RowCountKey;

    protected override void OnParametersSet() {
        Matrix = ReportProjection.Matrix(Context.Cube, MeasureKey, Context.Cube.Dimensions[0], Context.Cube.Dimensions[1], Context.Source);
        Layout = BarGeometry.Grouped(Matrix, Context.Style, Context.Cube.Normalized, Context.Labels.Other);
        _styles = Context.SeriesStyles(Layout.ColKeys);
    }

    private string ColLabel(string key) {
        var i = Layout.ColKeys.ToList().IndexOf(key);
        return i >= 0 ? Layout.ColLabels[i] : key;
    }

    private string LabelFor(string key, string fallback) =>
        Context.Definition.View.Labels.TryGetValue(key, out var custom) ? custom : fallback;

    private IReadOnlyList<GroupedBarCell> CellsFor(GroupedBarRow row) {
        var hide = Context.Definition.View.Sample == SampleRule.Hide;
        return [.. row.Cells.Where(c => !hide || !ReportProjection.BelowSample(c.Samples, Context.Definition.Query.MinSample))];
    }

    private bool Dimmed(GroupedBarCell cell) =>
        Context.Definition.View.Sample == SampleRule.Dim && ReportProjection.BelowSample(cell.Samples, Context.Definition.Query.MinSample);

    private string SeriesStyle(string key) => _styles.GetValueOrDefault(key, "");

    private string FormatValue(double value) {
        var format = Context.Source?.Measures.FirstOrDefault(m => string.Equals(m.Key, MeasureKey, StringComparison.Ordinal))?.Format
            ?? (MeasureKey == MeasureRequest.RowCountKey ? ValueFormat.Integer : ValueFormat.Decimal(2));
        return format.Format(value);
    }

    private string FillStyle(GroupedBarCell cell) =>
        string.Create(CultureInfo.InvariantCulture, $"width:{Math.Clamp(cell.Width, 0, 100):0.###}%;{SeriesStyle(cell.ColKey)}");

    private static string RowClass(bool dim) => dim ? "report-bar report-dim" : "report-bar";
}
