@inject IJSRuntime JS

<div class="combo-wrap" style="@AnchorStyle">
    <input type="text" class="form-input combo-anchor" placeholder="@Placeholder" value="@_query"
           @oninput="OnInput" @onfocus="OnFocus" @onfocusout="OnFocusOut" @onkeydown="OnKeyDown" @onkeydown:preventDefault="@_preventDefault"
           autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
    <div popover="manual" class="popover popover-combo" @ref="_listbox">
        @if (_filtered.Count == 0) {
            <div class="popover-combo-opt">No matches</div>
        } else {
            @foreach (var index in Enumerable.Range(0, _filtered.Count)) {
                var option = _filtered[index];
                <button type="button" class="@OptionCss(index)" @onmousedown:preventDefault="true" @onclick="() => SelectAsync(option)">@option.Label</button>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] [EditorRequired] public IReadOnlyList<ComboOption> Options { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }

    readonly string _anchor = "--combo-" + Guid.NewGuid().ToString("N");
    List<ComboOption> _filtered = [];
    string _query = "";
    string? _selectedValue;
    bool _open;
    bool _preventDefault;
    int _highlight;

    ElementReference _listbox;
    bool _shown;

    string AnchorStyle => $"--combo-anchor: {_anchor}";

    protected override void OnParametersSet() {
        if (Value == _selectedValue) return;
        _selectedValue = Value;
        _query = SelectedLabel;
    }

    string SelectedLabel => Options.FirstOrDefault(o => o.Value == Value)?.Label ?? "";

    void OnFocus() {
        _filtered = FilterOptions(_query);
        _highlight = 0;
        _open = true;
    }

    void OnFocusOut() {
        if (!_open) return;
        _query = SelectedLabel;
        _open = false;
    }

    void OnInput(ChangeEventArgs e) {
        _query = e.Value?.ToString() ?? "";
        _filtered = FilterOptions(_query);
        _highlight = 0;
        _open = true;
    }

    List<ComboOption> FilterOptions(string query) {
        if (string.IsNullOrWhiteSpace(query)) return Options.ToList();
        return Options.Where(o => o.Label.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    async Task OnKeyDown(KeyboardEventArgs e) {
        _preventDefault = false;
        if (!_open) {
            if (e.Key is "ArrowDown" or "ArrowUp") OnFocus();
            return;
        }

        switch (e.Key) {
            case "ArrowDown":
                _preventDefault = true;
                if (_filtered.Count > 0) _highlight = (_highlight + 1) % _filtered.Count;
                break;
            case "ArrowUp":
                _preventDefault = true;
                if (_filtered.Count > 0) _highlight = (_highlight - 1 + _filtered.Count) % _filtered.Count;
                break;
            case "Enter":
                _preventDefault = true;
                if (_highlight >= 0 && _highlight < _filtered.Count) await SelectAsync(_filtered[_highlight]);
                break;
            case "Escape":
                _preventDefault = true;
                _query = SelectedLabel;
                _open = false;
                break;
        }
    }

    async Task SelectAsync(ComboOption option) {
        _selectedValue = option.Value;
        _query = option.Label;
        _open = false;
        await ValueChanged.InvokeAsync(option.Value);
    }

    string OptionCss(int index) {
        return index == _highlight ? "popover-combo-opt combo-highlighted" : "popover-combo-opt";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_open == _shown) return;
        _shown = _open;
        try {
            await JS.InvokeVoidAsync(_open ? "comboBoxPickerShow" : "comboBoxPickerHide", _listbox);
        } catch (JSDisconnectedException) {
        }
    }
}
