<div class="@(string.IsNullOrEmpty(Class) ? "combo-wrap" : $"combo-wrap {Class}")" style="@AnchorStyle">
    <input type="text" class="form-input combo-anchor" placeholder="@Placeholder" @bind:get="_query" @bind:set="OnInput" @bind:event="oninput" @onfocus="OnFocus" @onfocusout="OnFocusOut" @onkeydown="OnKeyDown" @onkeydown:preventDefault="@_preventDefault"
           autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
    @if (_open) {
        <div class="popover popover-combo">
            @if (_filtered.Count == 0) {
                <div class="popover-combo-opt">No matches</div>
            } else {
                @foreach (var index in Enumerable.Range(0, _filtered.Count)) {
                    var option = _filtered[index];
                    @if (StartsGroup(index) is { } group) {
                        <div class="popover-combo-group">@group</div>
                    }
                    <button type="button" class="@OptionCss(index, option)" @onmousedown:preventDefault="true" @onclick="() => SelectAsync(option)">
                        @if (OptionTemplate is not null) {
                            @OptionTemplate(option)
                        } else if (option.IsRich) {
                            @if (!string.IsNullOrEmpty(option.Image)) {
                                <img class="combo-opt-img" src="@option.Image" alt=""/>
                            }
                            <span class="combo-opt-label">@option.Label</span>
                            @if (!string.IsNullOrEmpty(option.Badge)) {
                                <span class="badge badge-muted combo-opt-badge">@option.Badge</span>
                            }
                        } else {
                            @option.Label
                        }
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] [EditorRequired] public IReadOnlyList<ComboOption> Options { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment<ComboOption>? OptionTemplate { get; set; }

    readonly string _anchor = "--combo-" + Guid.NewGuid().ToString("N");
    List<ComboOption> _filtered = [];
    string _query = "";
    string? _selectedValue;
    bool _open;
    bool _preventDefault;
    int _highlight;

    string AnchorStyle => $"--combo-anchor: {_anchor}";

    protected override void OnParametersSet() {
        if (Value == _selectedValue) return;
        _selectedValue = Value;
        _query = SelectedLabel;
    }

    string SelectedLabel => Options.FirstOrDefault(o => o.Value == Value)?.Label ?? "";

    void OnFocus() {
        _filtered = FilterOptions(_query);
        _highlight = 0;
        _open = true;
    }

    void OnFocusOut() {
        if (!_open) return;
        _query = SelectedLabel;
        _open = false;
    }

    void OnInput(string? value) {
        _query = value ?? "";
        _filtered = FilterOptions(_query);
        _highlight = 0;
        _open = true;
    }

    List<ComboOption> FilterOptions(string query) {
        var matches = string.IsNullOrWhiteSpace(query) ? Options : Options.Where(o => Matches(o, query));
        return [.. matches.GroupBy(o => o.Group ?? "").SelectMany(g => g)];
    }

    static bool Matches(ComboOption option, string query) =>
        option.Label.Contains(query, StringComparison.OrdinalIgnoreCase)
        || (option.Badge?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false);

    string? StartsGroup(int index) {
        var group = _filtered[index].Group;
        if (string.IsNullOrEmpty(group)) return null;
        return index > 0 && _filtered[index - 1].Group == group ? null : group;
    }

    async Task OnKeyDown(KeyboardEventArgs e) {
        _preventDefault = false;
        if (!_open) {
            if (e.Key is "ArrowDown" or "ArrowUp") OnFocus();
            return;
        }

        switch (e.Key) {
            case "ArrowDown":
                _preventDefault = true;
                if (_filtered.Count > 0) _highlight = (_highlight + 1) % _filtered.Count;
                break;
            case "ArrowUp":
                _preventDefault = true;
                if (_filtered.Count > 0) _highlight = (_highlight - 1 + _filtered.Count) % _filtered.Count;
                break;
            case "Enter":
                _preventDefault = true;
                if (_highlight >= 0 && _highlight < _filtered.Count) await SelectAsync(_filtered[_highlight]);
                break;
            case "Escape":
                _preventDefault = true;
                _query = SelectedLabel;
                _open = false;
                break;
        }
    }

    async Task SelectAsync(ComboOption option) {
        _selectedValue = option.Value;
        _query = option.Label;
        _open = false;
        await ValueChanged.InvokeAsync(option.Value);
    }

    string OptionCss(int index, ComboOption option) {
        var css = OptionTemplate is not null || option.IsRich ? "popover-combo-opt combo-opt-rich" : "popover-combo-opt";
        if (index == _highlight) css += " combo-highlighted";
        return string.IsNullOrEmpty(option.Class) ? css : $"{css} {option.Class}";
    }
}
