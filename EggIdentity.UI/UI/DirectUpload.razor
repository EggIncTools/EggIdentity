@implements IDisposable
@inject UploadStore Uploads

<form method="post" enctype="multipart/form-data" action="@Url" target="@_frameId" class="@Class">
    <input type="hidden" name="@UploadStore.TicketField" value="@_ticket" />
    <input type="file" name="file" accept="@Accept" multiple="@Multiple" disabled="@(Disabled || _busy)" @onchange="e => _chosen = e.Value is string s && s.Length > 0" />
    <button type="submit" class="@ButtonClass" disabled="@(Disabled || _busy || !_chosen)" @onclick="StartAsync">@Label</button>
</form>
<iframe name="@_frameId" hidden aria-hidden="true" tabindex="-1" title="" @onload="Returned"></iframe>

@code {
    [Parameter, EditorRequired] public string Url { get; set; } = "";
    [Parameter] public string? Accept { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public int TimeoutMs { get; set; } = 120_000;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string ButtonClass { get; set; } = "btn-secondary";
    [Parameter] public string Label { get; set; } = "Upload";
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback<UploadResult> OnResult { get; set; }

    readonly string _frameId = "upload-" + Guid.NewGuid().ToString("N");
    readonly CancellationTokenSource _gone = new();
    string _ticket = "";
    bool _busy;
    bool _chosen;

    protected override void OnInitialized() => _ticket = Uploads.Open();

    async Task StartAsync() {
        _busy = true;
        await OnStart.InvokeAsync();
        var result = await Uploads.WaitAsync(_ticket, TimeSpan.FromMilliseconds(TimeoutMs), _gone.Token) ?? new UploadResult(0, "timeout");
        _ticket = Uploads.Open();
        _busy = false;
        _chosen = false;
        await OnResult.InvokeAsync(result);
    }

    void Returned() {
        if (_busy) Uploads.Complete(_ticket, new UploadResult(0, "endpoint did not complete the upload ticket"));
    }

    public void Dispose() {
        _gone.Cancel();
        _gone.Dispose();
        Uploads.Cancel(_ticket);
    }
}
