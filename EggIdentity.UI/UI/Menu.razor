<div class="@WrapCss" @onkeydown="OnKeyDown">
    @if (_open) {
        <div class="menu-scrim" @onclick="CloseAsync"></div>
    }
    <button type="button" class="@TriggerClass" aria-haspopup="menu" aria-expanded="@(_open ? "true" : "false")" aria-label="@TriggerLabel" @onclick="() => SetOpenAsync(!_open)">@Trigger</button>
    <div class="@MenuCss" role="menu" style="@MenuStyle" @onclick="OnMenuClick">@ChildContent</div>
</div>

@code {
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public string TriggerClass { get; set; } = "icon-btn";
    [Parameter] public string? TriggerLabel { get; set; }
    [Parameter] public bool AlignStart { get; set; }
    [Parameter] public string? MaxHeight { get; set; }
    [Parameter] public bool CloseOnSelect { get; set; } = true;
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    bool _open;
    bool _lastOpen;

    string WrapCss => string.IsNullOrEmpty(Class) ? "menu-wrap" : $"menu-wrap {Class}";

    string MenuCss => (AlignStart ? "menu menu-start" : "menu") + (_open ? " open" : "");

    string? MenuStyle => string.IsNullOrWhiteSpace(MaxHeight) ? null : $"--menu-max-h: {MaxHeight}";

    protected override void OnParametersSet() {
        if (Open == _lastOpen) return;
        _open = Open;
        _lastOpen = Open;
    }

    public Task CloseAsync() => SetOpenAsync(false);

    Task OnMenuClick() => CloseOnSelect ? SetOpenAsync(false) : Task.CompletedTask;

    Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? SetOpenAsync(false) : Task.CompletedTask;

    async Task SetOpenAsync(bool open) {
        if (_open == open) return;
        _open = open;
        StateHasChanged();
        await OpenChanged.InvokeAsync(open);
    }
}
