<div id="components-reconnect-modal" class="rcn" role="status" aria-live="polite" aria-label="Connection status"
     data-version="@Version" data-version-url="@VersionUrl" data-boot="@(StartBlazor ? "true" : "false")">
    <div class="rcn-state rcn-reconnecting">
        <span class="rcn-spinner" aria-hidden="true"></span>
        <p class="rcn-text">Reconnecting...</p>
    </div>
    <div class="rcn-state rcn-paused">
        <p class="rcn-text">Paused.</p>
        <button type="button" class="btn-primary btn-mini" data-rcn-action="resume">Resume</button>
    </div>
    <div class="rcn-state rcn-failed">
        <p class="rcn-text">Could not reconnect.</p>
        <button type="button" class="btn-primary btn-mini" data-rcn-action="reload">Reload</button>
    </div>
    <div class="rcn-state rcn-resume-failed">
        <p class="rcn-text">Could not resume.</p>
        <button type="button" class="btn-primary btn-mini" data-rcn-action="reload">Reload</button>
    </div>
    <div class="rcn-state rcn-rejected">
        <span class="rcn-spinner" aria-hidden="true"></span>
        <p class="rcn-text">Reloading...</p>
    </div>
    <div class="rcn-state rcn-updated">
        <span class="rcn-spinner" aria-hidden="true"></span>
        <p class="rcn-text">Updated to <span class="rcn-new-version"></span>. Reloading...</p>
    </div>
    <div class="rcn-state rcn-back">
        <p class="rcn-text">Back online.</p>
    </div>
</div>
<script type="module" src="_content/EggIdentity.UI/circuit.js"></script>

@code {
    [Parameter] public string Version { get; set; } = AppVersion.Current;
    [Parameter] public string VersionUrl { get; set; } = AppVersion.Path;
    [Parameter] public bool StartBlazor { get; set; } = true;
}
