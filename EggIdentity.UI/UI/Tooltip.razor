@if (Tag == "div") {
    <div class="@TriggerCss" style="--tt-anchor: --@_id;@Style" tabindex="@(Focusable ? "0" : null)" aria-describedby="@_id"
         @onkeydown="OnKeyDown" @onmouseleave="Rearm" @onfocusout="Rearm">@ChildContent@Pop</div>
} else {
    <span class="@TriggerCss" style="--tt-anchor: --@_id;@Style" tabindex="@(Focusable ? "0" : null)" aria-describedby="@_id"
          @onkeydown="OnKeyDown" @onmouseleave="Rearm" @onfocusout="Rearm">@ChildContent@Pop</span>
}

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public IReadOnlyList<TooltipLine>? Lines { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? PopClass { get; set; }
    [Parameter] public string Tag { get; set; } = "span";
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Focusable { get; set; }

    readonly string _id = "tt-" + Guid.NewGuid().ToString("N");
    bool _dismissed;

    RenderFragment Pop => @<span id="@_id" role="tooltip" class="@PopCss">@if (Content is not null) {
            @Content
        } else if (Lines is not null && Lines.Any(l => l.Value is not null)) {
            <span class="tooltip-rows">
                @foreach (var line in Lines) {
                    if (line.Head || line.Value is null) {
                        <span class="@line.Css tooltip-row-span">@line.Text</span>
                    } else {
                        <span class="@line.Css">@line.Text</span>
                        <span class="@line.ValueCss" style="@line.ValueStyle">@line.Value</span>
                    }
                }
            </span>
        } else if (Lines is not null) {
            @foreach (var line in Lines) {
                <span class="@line.Css">@line.Text</span>
            }
        } else {
            @Text
        }</span>;

    string TriggerCss {
        get {
            var css = _dismissed ? "tooltip-trigger tt-dismissed" : "tooltip-trigger";
            return string.IsNullOrEmpty(Class) ? css : $"{css} {Class}";
        }
    }

    string PopCss {
        get {
            var css = Error ? "tooltip-floating tooltip-fixed tooltip-toggle tooltip-err" : "tooltip-floating tooltip-fixed tooltip-toggle";
            return string.IsNullOrEmpty(PopClass) ? css : $"{css} {PopClass}";
        }
    }

    void OnKeyDown(KeyboardEventArgs e) => _dismissed |= e.Key == "Escape";

    void Rearm() => _dismissed = false;
}
