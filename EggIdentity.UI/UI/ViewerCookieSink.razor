@implements IDisposable
@inject ViewerCookies Cookies
@inject PersistentComponentState State

<CircuitGuard @ref="_guard" Name="ViewerCookieSink">
    @foreach (var (name, url) in Cookies.PendingByName) {
        <iframe @key="name" src="@url" hidden aria-hidden="true" tabindex="-1" title="" @onload="() => Cookies.Written(name, url)"></iframe>
    }
</CircuitGuard>

@code {
    const string StateKey = "eggidentity-viewer-cookies";
    PersistingComponentStateSubscription _persisting;
    CircuitGuard? _guard;

    protected override void OnInitialized() {
        Cookies.Changed += Refresh;
        if (!Cookies.ClaimPersistence()) return;
        if (State.TryTakeFromJson<Dictionary<string, string>>(StateKey, out var restored) && restored is not null) {
            Cookies.Restore(restored);
            return;
        }
        _persisting = State.RegisterOnPersisting(() => {
            State.PersistAsJson(StateKey, new Dictionary<string, string>(Cookies.Values));
            return Task.CompletedTask;
        });
    }

    void Refresh() => _ = InvokeAsync(() => {
        _guard?.Recover();
        StateHasChanged();
    });

    public void Dispose() {
        Cookies.Changed -= Refresh;
        _persisting.Dispose();
    }
}
