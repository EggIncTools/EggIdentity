@inject SuiteContext Suite
@inject NavigationManager Nav

<CircuitGuard Name="SuiteAccount">
    <div class="@($"suite-account {SuitePlacements.Css(Placement)}")">
        @if (Suite.Viewer.IsAuthenticated) {
            <details class="suite-account-menu" @key="_menuKey">
                <summary class="suite-user" @ref="_trigger">
                    @if (Suite.Viewer.AvatarUrl(SuiteCatalog.IdentityOrigin) is { } avatar) {
                        <img class="suite-avatar" src="@avatar" alt="" width="24" height="24"/>
                    } else {
                        <Icon Name="user" Class="suite-avatar"/>
                    }
                    <span class="suite-user-name">@Suite.Viewer.Name</span>
                </summary>
                <div class="suite-account-panel">
                    <button type="button" class="suite-account-link suite-profile-open" @onclick="OpenProfile">Profile</button>
                    <a class="suite-account-link" href="@SuiteCatalog.SignOutUrlFor(Nav.Uri)">Sign out</a>
                </div>
            </details>
        } else {
            <details class="suite-account-menu">
                <summary class="suite-signin">Sign in</summary>
                <div class="suite-account-panel">
                    @foreach (var provider in SuiteCatalog.Providers) {
                        <a class="suite-provider" href="@SuiteCatalog.ProviderSignInUrl(provider, Nav.Uri)">
                            <Icon Name="@SuiteCatalog.ProviderIcon(provider)"/>
                            <span>@ProviderName(provider)</span>
                        </a>
                    }
                </div>
            </details>
        }
        <SuiteProfileModal Open="_profileOpen" OnClose="CloseProfile" ReturnFocusTo="_trigger" Templates="ProfileTemplates"/>
    </div>
</CircuitGuard>

@code {
    [Parameter] public SuitePlacement Placement { get; set; } = SuitePlacement.Bar;
    [Parameter] public SuiteProfileTemplates? ProfileTemplates { get; set; }

    ElementReference _trigger;
    int _menuKey;
    bool _profileOpen;

    protected override Task OnInitializedAsync() => Suite.LoadAsync();

    internal void OpenProfile() {
        _menuKey++;
        _profileOpen = true;
    }

    void CloseProfile() => _profileOpen = false;

    internal static string ProviderName(string provider) => provider switch {
        "github" => "GitHub",
        _ => char.ToUpperInvariant(provider[0]) + provider[1..],
    };
}
