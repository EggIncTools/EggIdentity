@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Open && !UseNativeDialog) {
    <div class="modal-backdrop" @ref="_root" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@TitleId"
         @onkeydown="OnKeyDown" @onclick="OnBackdropClick">
        <div class="@CardCss" tabindex="-1" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3 class="modal-title" id="@TitleId">@Title</h3>
                @HeadTools
                @if (!HideClose) {
                    <button type="button" class="icon-btn" aria-label="Close" @onclick="Close">
                        <Icon Name="close"/>
                    </button>
                }
            </div>
            @ChildContent
        </div>
    </div>
}
@if (Open && UseNativeDialog) {
    <dialog class="modal-backdrop" @ref="_root" tabindex="-1" open aria-labelledby="@TitleId"
            @onkeydown="OnKeyDown" @onclick="OnBackdropClick">
        <div class="@CardCss" tabindex="-1" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3 class="modal-title" id="@TitleId">@Title</h3>
                @HeadTools
                @if (!HideClose) {
                    <button type="button" class="icon-btn" aria-label="Close" @onclick="Close">
                        <Icon Name="close"/>
                    </button>
                }
            </div>
            @ChildContent
        </div>
    </dialog>
}

@code {

    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? TitleId { get; set; }
    [Parameter] public string? CardClass { get; set; }
    [Parameter] public ModalWidth Width { get; set; } = ModalWidth.Regular;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool HideClose { get; set; }
    [Parameter] public bool UseNativeDialog { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? HeadTools { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    ElementReference _root;
    bool _wasOpen;
    bool _pendingFocus;

    string CardCss {
        get {
            var css = "modal-card" + Width switch {
                ModalWidth.Small => " modal-card-sm",
                ModalWidth.Large => " modal-card-lg",
                _ => ""
            };
            return string.IsNullOrEmpty(CardClass) ? css : $"{css} {CardClass}";
        }
    }

    protected override void OnParametersSet() {
        if (Open && !_wasOpen) _pendingFocus = true;
        if (!Open && _wasOpen) _ = SetScrollLockAsync(false);
        _wasOpen = Open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!_pendingFocus) return;
        _pendingFocus = false;
        await _root.FocusAsync();
        await SetScrollLockAsync(true);
    }

    async Task SetScrollLockAsync(bool locked) {
        try {
            await JS.InvokeVoidAsync(locked ? "modalScrollLock" : "modalScrollUnlock");
        }
        catch (JSDisconnectedException) {
        }
    }

    Task OnBackdropClick() {
        return CloseOnBackdrop ? Close() : Task.CompletedTask;
    }

    Task OnKeyDown(KeyboardEventArgs e) {
        return CloseOnEscape && e.Key == "Escape" ? Close() : Task.CompletedTask;
    }

    Task Close() {
        return OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync() {
        if (!_wasOpen) return;
        await SetScrollLockAsync(false);
    }

}
