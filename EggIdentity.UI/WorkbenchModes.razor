@if (Modes.Count > 0) {
    <div class="segmented" role="group" aria-label="@Label">
        @foreach (var mode in Modes) {
            <button type="button" class="@BtnCss(mode.Key)" disabled="@IsDisabled(mode.Key)"
                    aria-pressed="@(Current == mode.Key ? "true" : "false")"
                    @onclick="@(() => CurrentChanged.InvokeAsync(mode.Key))">
                @mode.Label
                @if (mode.Count is { } n) {
                    <span class="wb-seg-count">@n</span>
                }
            </button>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<(string Key, string Label, int? Count)> Modes { get; set; } = [];
    [Parameter] public string Current { get; set; } = "";
    [Parameter] public EventCallback<string> CurrentChanged { get; set; }
    [Parameter] public Func<string, bool>? Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "View mode";

    string BtnCss(string key) {
        return Current == key ? "segmented-opt active" : "segmented-opt";
    }

    bool IsDisabled(string key) {
        return Disabled?.Invoke(key) ?? false;
    }

}
