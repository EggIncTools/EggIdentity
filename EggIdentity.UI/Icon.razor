@using EggIdentity.Icons
<span class="icon @Class">@((MarkupString)Markup)</span>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? Icons { get; set; }

    string Markup => Icons is not null && Icons.TryGetValue(Name, out var overridden) ? overridden : IconPack.Get(Name) ?? "";
}
