<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Authentik OAuth, ASP.NET auth scheme, bearer-session middleware and the cross-site SSO session cookie. No DB access.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Client\EggIdentity.Client.csproj" />
    <ProjectReference Include="..\EggIdentity.Settings\EggIdentity.Settings.csproj" />
  </ItemGroup>

</Project>
