<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EggIdentity</RootNamespace>
    <Description>EggIdentity auth: Authentik OAuth helpers, the ASP.NET scheme, bearer-session middleware, the cross-site SSO session cookie and CurrentUser (Auth), plus the typed identity API client for consuming apps (Client).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Core\EggIdentity.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.Auth.Tests" />
  </ItemGroup>

</Project>
