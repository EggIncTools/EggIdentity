<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EggIdentity</RootNamespace>
    <Description>EggIdentity admin: profile panel (AdminUi), the settings admin API and workbench (Settings.Api, Settings.AdminUi), the suite.apps registry with FleetClient and event hub (Deploy), the deploy/fleet/clone panels (Deploy.AdminUi), and the hub's SuitePanel (Suite.AdminUi).</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Data\EggIdentity.Data.csproj" />
    <ProjectReference Include="..\EggIdentity.Auth\EggIdentity.Auth.csproj" />
    <ProjectReference Include="..\EggIdentity.UI\EggIdentity.UI.csproj" />
    <ProjectReference Include="..\EggIdentity.Bot\EggIdentity.Bot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.Admin.Tests" />
  </ItemGroup>

</Project>
