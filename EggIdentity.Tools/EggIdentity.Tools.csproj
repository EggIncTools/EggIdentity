<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Maintenance console: one-time users/identities cutover from EggIncognito and EggLedger (dry-run by default), the clone-subprod verbs, and the css emit verb that regenerates the shared stylesheet assets.</Description>
    <RootNamespace>EggIdentity.Tools</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonorailCss" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.UI\EggIdentity.UI.csproj" />
    <ProjectReference Include="..\EggIdentity\EggIdentity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.Tools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\EggIdentity\Migrations\*.up.sql" Link="Migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EmitSharedCss" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(CI)' != 'true'">
    <PropertyGroup>
      <CssEmitHost>$(DOTNET_HOST_PATH)</CssEmitHost>
      <CssEmitHost Condition="'$(CssEmitHost)' == ''">dotnet</CssEmitHost>
    </PropertyGroup>
    <Exec Command="&quot;$(CssEmitHost)&quot; &quot;$(TargetPath)&quot; css emit" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
