<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Maintenance console: one-time users/identities cutover from EggIncognito and EggLedger (dry-run by default) and import-authentik-apps, which moves AUTHENTIK_APPS_DIR dotenv files into the authentik.apps settings collection.</Description>
    <RootNamespace>EggIdentity.Tools</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Db\EggIdentity.Db.csproj" />
    <ProjectReference Include="..\EggIdentity\EggIdentity.csproj" />
    <ProjectReference Include="..\EggIdentity.Host\EggIdentity.Host.csproj" />
    <ProjectReference Include="..\EggIdentity.Settings\EggIdentity.Settings.csproj" />
    <ProjectReference Include="..\EggIdentity.Settings.Store\EggIdentity.Settings.Store.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.Tools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\EggIdentity\Migrations\*.up.sql" Link="Migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
