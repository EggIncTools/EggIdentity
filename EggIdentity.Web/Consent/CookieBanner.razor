@namespace EggIdentity.Consent

<ViewerCookieSink/>

<CircuitGuard Name="CookieBanner">
@if (Visible) {
    <div class="consent-banner" role="dialog" aria-label="Cookie consent">
        @if (Body is not null) {
            @Body(Context)
        } else {
            <p class="consent-text">
                @Message
                @if (!string.IsNullOrEmpty(PrivacyUrl) || !string.IsNullOrEmpty(TermsUrl)) {
                    <span class="consent-links">
                        @if (!string.IsNullOrEmpty(PrivacyUrl)) {
                            <a href="@PrivacyUrl">@PrivacyLabel</a>
                        }
                        @if (!string.IsNullOrEmpty(TermsUrl)) {
                            <a href="@TermsUrl">@TermsLabel</a>
                        }
                    </span>
                }
            </p>
        }
        @if (Configuring) {
            @if (Options is not null) {
                @Options(Context)
            } else {
                <div class="consent-options">
                    <label class="consent-option"><input type="checkbox" @bind="_functional" /> @FunctionalLabel</label>
                    <label class="consent-option"><input type="checkbox" @bind="_analytics" /> @AnalyticsLabel</label>
                </div>
            }
        }
        @if (Actions is not null) {
            @Actions(Context)
        } else {
            <div class="consent-actions">
                @if (Configuring) {
                    <button type="button" class="btn-primary" @onclick="() => DecideAsync(_functional, _analytics)">@SaveLabel</button>
                } else {
                    <button type="button" class="btn-primary" @onclick="() => DecideAsync(true, true)">@AcceptAllLabel</button>
                    <button type="button" class="btn-secondary" @onclick="() => DecideAsync(false, false)">@NecessaryOnlyLabel</button>
                    <button type="button" class="btn-secondary" @onclick="Configure">@ConfigureLabel</button>
                }
            </div>
        }
    </div>
}
</CircuitGuard>
