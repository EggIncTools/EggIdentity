<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EggIdentity</RootNamespace>
    <Description>EggIdentity web surface: suite cookie consent (Consent), anonymous cookieless visit counting (Visits), in-memory request-rate and traffic audit (Metrics), the shared exception/maintenance/404/down pages (Fallback), and the fenced loopback sign-in for local sub-prod testing (SubProd).</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);Worker\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Data\EggIdentity.Data.csproj" />
    <ProjectReference Include="..\EggIdentity.Auth\EggIdentity.Auth.csproj" />
    <ProjectReference Include="..\EggIdentity.UI\EggIdentity.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Visits\Migrations\*.up.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggIdentity.Web.Tests" />
  </ItemGroup>

  <Target Name="PublishReportsWorker" BeforeTargets="PrepareForBuild" Condition="'$(SkipReportsWorker)' != 'true'">
    <MSBuild Projects="Worker\EggIdentity.Web.Worker.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(MSBuildProjectDirectory)\obj\reports-worker\" />
  </Target>

  <ItemGroup>
    <Content Include="obj\reports-worker\wwwroot\_framework\**" Link="wwwroot\reports-worker\_framework\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
