@inject SuiteContext Suite
@inject NavigationManager Nav

<CircuitGuard Name="SuiteAccount">
    <div class="@($"suite-account {SuitePlacements.Css(Placement)}")" style="@AnchorStyle">
        @if (Suite.Viewer.IsAuthenticated) {
            <button type="button" class="suite-user suite-account-anchor" popovertarget="@_panelId" @ref="_trigger">
                @if (Suite.Viewer.AvatarUrl(SuiteCatalog.IdentityOrigin) is { } avatar) {
                    <img class="suite-avatar" src="@avatar" alt="" width="24" height="24"/>
                } else {
                    <Icon Name="user" Class="suite-avatar"/>
                }
                <span class="suite-user-name">@Suite.Viewer.Name</span>
            </button>
            <div id="@_panelId" popover class="suite-account-panel">
                <button type="button" class="suite-account-link suite-profile-open" popovertarget="@_panelId" popovertargetaction="hide" @onclick="OpenProfile">@ProfileLabel</button>
                <a class="suite-account-link" href="@SuiteCatalog.SignOutUrlFor(Nav.Uri)">@SignOutLabel</a>
            </div>
        } else {
            <button type="button" class="suite-signin suite-account-anchor" popovertarget="@_panelId">@LoginLabel</button>
            <div id="@_panelId" popover class="suite-account-panel">
                @foreach (var provider in SuiteCatalog.Providers) {
                    <a class="suite-provider" href="@SuiteCatalog.ProviderSignInUrl(provider, Nav.Uri)">
                        <Icon Name="@SuiteCatalog.ProviderIcon(provider)" Icons="ProviderIcons"/>
                        <span>@ProviderName(provider)</span>
                    </a>
                }
            </div>
        }
        <SuiteProfileModal Open="_profileOpen" OnClose="CloseProfile" ReturnFocusTo="_trigger" Templates="ProfileTemplates" ProviderIcons="ProviderIcons" LoginLabel="@LoginLabel"/>
    </div>
</CircuitGuard>

@code {
    [Parameter] public SuitePlacement Placement { get; set; } = SuitePlacement.Bar;
    [Parameter] public SuiteProfileTemplates? ProfileTemplates { get; set; }
    [Parameter] public string LoginLabel { get; set; } = "Login";
    [Parameter] public string ProfileLabel { get; set; } = "Profile";
    [Parameter] public string SignOutLabel { get; set; } = "Sign out";
    [Parameter] public IReadOnlyDictionary<string, string>? ProviderIcons { get; set; }
    [Parameter] public EventCallback OnOpenProfile { get; set; }

    readonly string _panelId = "suite-account-" + Guid.NewGuid().ToString("N");
    readonly string _anchor = "--suite-account-" + Guid.NewGuid().ToString("N");
    ElementReference _trigger;
    bool _profileOpen;

    string AnchorStyle => $"--suite-account-anchor: {_anchor}";

    protected override Task OnInitializedAsync() => Suite.LoadAsync();

    internal Task OpenProfile() {
        if (OnOpenProfile.HasDelegate) return OnOpenProfile.InvokeAsync();
        _profileOpen = true;
        return Task.CompletedTask;
    }

    void CloseProfile() => _profileOpen = false;

    internal static string ProviderName(string provider) => provider switch {
        "github" => "GitHub",
        _ => char.ToUpperInvariant(provider[0]) + provider[1..],
    };
}
