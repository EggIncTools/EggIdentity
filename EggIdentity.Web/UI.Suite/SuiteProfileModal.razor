@inject SuiteContext Suite
@inject ToastService Toasts
@inject NavigationManager Nav

<ModalHost Open="Open" Title="Profile" TitleId="@_titleId" Width="ModalWidth.Regular" CloseOnEscape="true" CloseOnBackdrop="true"
           ReturnFocusTo="ReturnFocusTo" OnClose="OnClose" CardClass="@CardCss">
    @if (!Suite.Viewer.IsAuthenticated) {
        <div class="suite-profile-body">
            <p class="suite-profile-note">@LoginLabel to manage your profile.</p>
            <div class="suite-profile-providers">
                @foreach (var provider in SuiteCatalog.Providers) {
                    <a class="suite-provider" href="@SuiteCatalog.ProviderSignInUrl(provider, Nav.Uri)">
                        <Icon Name="@SuiteCatalog.ProviderIcon(provider)" Icons="ProviderIcons"/>
                        <span>@SuiteAccount.ProviderName(provider)</span>
                    </a>
                }
            </div>
        </div>
    } else if (_profile is null) {
        <div class="suite-profile-body">
            <p class="suite-profile-note">@(_loadFailed ? "Profile could not be loaded." : "Loading...")</p>
        </div>
    } else {
        <div class="suite-profile-body">
            @if (Slots?.Avatar is { } avatarSlot) {
                @avatarSlot(AvatarContext)
            } else {
                <section class="suite-profile-section">
                    <div class="suite-profile-head">
                        @if (AvatarContext.AvatarUrl is { } avatar) {
                            <img class="suite-profile-avatar" src="@avatar" alt="" width="64" height="64"/>
                        } else {
                            <Icon Name="user" Class="suite-profile-avatar"/>
                        }
                        <span class="suite-profile-name">@AvatarContext.Username</span>
                    </div>
                    @AvatarContext.Upload
                </section>
            }

            @if (Slots?.Identities is { } identitiesSlot) {
                @identitiesSlot(IdentitiesContext)
            } else {
                <section class="suite-profile-section">
                    <h4 class="suite-profile-label">Linked identities</h4>
                    <ul class="suite-profile-identities">
                        @foreach (var item in IdentitiesContext.Items) {
                            <li class="suite-profile-identity">
                                <Icon Name="@item.ProviderIcon" Icons="ProviderIcons"/>
                                <span class="suite-profile-identity-name">@(item.Identity.Username ?? item.Identity.Subject)</span>
                                @if (!string.IsNullOrEmpty(item.Identity.Avatar)) {
                                    <button type="button" class="btn-mini" @onclick="item.OnSelectAvatar">Use avatar</button>
                                }
                                <button type="button" class="btn-mini" disabled="@(!item.CanUnlink)" title="@item.UnlinkReason"
                                        @onclick="item.OnUnlink">Unlink</button>
                            </li>
                        }
                    </ul>
                    <button type="button" class="btn-mini" @onclick="IdentitiesContext.OnSync">Sync from provider</button>
                </section>
            }

            @if (Slots?.Preferences is { } preferencesSlot) {
                @preferencesSlot(PreferencesContext)
            } else {
                <section class="suite-profile-section suite-profile-grid">
                    <label class="suite-profile-field">
                        <span class="suite-profile-label">Timezone</span>
                        <TimeZonePicker Value="@PreferencesContext.Timezone" ValueChanged="PreferencesContext.OnTimezone"/>
                    </label>
                    <label class="suite-profile-field">
                        <span class="suite-profile-label">Language</span>
                        <LanguagePicker Value="@PreferencesContext.Language" ValueChanged="PreferencesContext.OnLanguage"/>
                    </label>
                    <label class="suite-profile-field">
                        <span class="suite-profile-label">Theme</span>
                        <select class="form-input" value="@PreferencesContext.Theme" @onchange="e => ThemeAsync(e.Value as string)">
                            @foreach (var theme in PreferencesContext.Themes) {
                                <option value="@theme">@theme</option>
                            }
                        </select>
                    </label>
                    <label class="suite-profile-field suite-profile-check">
                        <input type="checkbox" checked="@PreferencesContext.ReducedMotion" @onchange="e => MotionAsync(e.Value is true)"/>
                        <span>Reduce motion</span>
                    </label>
                </section>
            }

            @if (Slots?.Eid is { } eidSlot) {
                @eidSlot(EidContext)
            } else {
                <section class="suite-profile-section">
                    <h4 class="suite-profile-label">Egg Inc accounts</h4>
                    <SuiteEidEditor/>
                </section>
            }
        </div>
    }
</ModalHost>

@code {
    public const string LastIdentityReason = "Cannot unlink the last identity on an account";
    public const string AvatarAccept = "image/png,image/jpeg,image/webp,image/gif";

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public ElementReference? ReturnFocusTo { get; set; }
    [Parameter] public SuiteProfileTemplates? Templates { get; set; }
    [CascadingParameter] public SuiteProfileTemplates? CascadedTemplates { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? ProviderIcons { get; set; }
    [Parameter] public string LoginLabel { get; set; } = "Login";

    readonly string _titleId = "suite-profile-" + Guid.NewGuid().ToString("N");
    ProfileResponse? _profile;
    bool _loadFailed;
    bool _wasOpen;

    SuiteProfileTemplates? Slots => Templates ?? CascadedTemplates;

    string CardCss => Slots?.CardClass is { Length: > 0 } extra ? $"suite-profile {extra}" : "suite-profile";

    SuiteProfileAvatarContext AvatarContext => new(
        AvatarSrc(_profile!.Avatar), _profile.AvatarIsCustom, _profile.Username,
        @<DirectUpload Url="@SuiteRoutes.AvatarPath" Accept="@AvatarAccept" Label="Upload avatar" Class="suite-profile-upload" OnResult="AvatarUploadedAsync"/>);

    SuiteProfileIdentitiesContext IdentitiesContext => new(
        [.. _profile!.Identities.Select(identity => {
            var canUnlink = _profile.Identities.Count > 1;
            return new SuiteProfileIdentityItem(
                identity,
                SuiteCatalog.ProviderIcon(identity.Provider),
                SuiteAccount.ProviderName(identity.Provider),
                !string.IsNullOrEmpty(identity.Avatar) && identity.Avatar == _profile.Avatar,
                canUnlink,
                canUnlink ? null : LastIdentityReason,
                EventCallback.Factory.Create(this, () => SelectAvatarAsync(identity)),
                EventCallback.Factory.Create(this, () => UnlinkAsync(identity)));
        })],
        EventCallback.Factory.Create(this, SyncAsync));

    SuiteProfilePreferencesContext PreferencesContext => new(
        _profile!.Timezone, _profile.Language, Suite.Theme, Suite.Themes, Suite.ReducedMotion,
        EventCallback.Factory.Create<string?>(this, TimezoneAsync),
        EventCallback.Factory.Create<string?>(this, LanguageAsync),
        EventCallback.Factory.Create<string>(this, ThemeAsync),
        EventCallback.Factory.Create<bool>(this, MotionAsync));

    SuiteProfileEidContext EidContext => new(
        Suite.ActiveEid, Suite.ActiveEidLabel, ProfileGame.MaxEidLength, ProfileGame.MaxLabelLength,
        EventCallback.Factory.Create<(string?, string?)>(this, SaveEidAsync),
        Suite.Eids,
        (eid, label, snapshot) => Suite.AddEidAsync(eid, label, snapshot),
        (eid, label) => Suite.RenameEidAsync(eid, label),
        eid => Suite.RemoveEidAsync(eid),
        order => Suite.ReorderEidsAsync(order));

    protected override async Task OnParametersSetAsync() {
        var opening = Open && !_wasOpen;
        _wasOpen = Open;
        if (opening && Suite.Viewer.IsAuthenticated) await LoadAsync();
    }

    async Task LoadAsync() {
        await Suite.LoadAsync();
        try {
            _profile = await Suite.GetProfileAsync();
            _loadFailed = _profile is null;
        } catch (HttpRequestException) {
            _loadFailed = true;
        }
    }

    static string? AvatarSrc(string? avatar) =>
        string.IsNullOrEmpty(avatar) || !avatar.StartsWith('/') || avatar.StartsWith("//", StringComparison.Ordinal)
            ? avatar
            : SuiteCatalog.IdentityOrigin + avatar;

    async Task Report(Task<bool> work, string ok, string failed, bool reload = false) {
        bool success;
        try {
            success = await work;
        } catch (HttpRequestException) {
            success = false;
        }
        Toasts.Push(success ? StatusNoteKind.Ok : StatusNoteKind.Error, success ? ok : failed);
        if (success && reload) await LoadAsync();
    }

    Task SelectAvatarAsync(ProfileIdentityResponse identity) =>
        Report(Suite.SelectAvatarAsync(identity.Provider, identity.Subject), "Avatar updated.", "Could not use that avatar.", reload: true);

    Task UnlinkAsync(ProfileIdentityResponse identity) =>
        Report(Suite.UnlinkIdentityAsync(identity.Provider, identity.Subject), "Identity unlinked.", "Could not unlink that identity.", reload: true);

    Task SyncAsync() => Report(Suite.SyncIdentitiesAsync(), "Identities synced.", "Could not sync from the provider.", reload: true);

    Task TimezoneAsync(string? timezone) =>
        Report(Suite.SetLocaleAsync(timezone, null), "Timezone saved.", "Could not save the timezone.", reload: true);

    Task LanguageAsync(string? language) =>
        Report(Suite.SetLocaleAsync(null, language), "Language saved.", "Could not save the language.", reload: true);

    Task ThemeAsync(string? theme) =>
        string.IsNullOrWhiteSpace(theme)
            ? Task.CompletedTask
            : Report(Done(Suite.SetThemeAsync(theme)), "Theme saved.", "Could not save the theme.");

    Task MotionAsync(bool reduced) =>
        Report(Done(Suite.SetReducedMotionAsync(reduced)), "Motion preference saved.", "Could not save the motion preference.");

    Task SaveEidAsync((string? Eid, string? Label) value) {
        if (value.Eid?.Trim().Length > ProfileGame.MaxEidLength) {
            Toasts.Push(StatusNoteKind.Error, "That EID is too long.");
            return Task.CompletedTask;
        }
        return Report(Done(Suite.SetActiveEidAsync(value.Eid, value.Label)), "Active EID saved.", "Could not save the EID.");
    }

    async Task AvatarUploadedAsync(UploadResult result) {
        Toasts.Push(result.Ok ? StatusNoteKind.Ok : StatusNoteKind.Error,
            result.Ok ? "Avatar uploaded." : "Upload failed: unsupported file type or too large.");
        if (result.Ok) await LoadAsync();
    }

    static async Task<bool> Done(Task work) {
        await work;
        return true;
    }
}
