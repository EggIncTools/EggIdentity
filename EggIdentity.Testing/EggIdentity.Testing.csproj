<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Test doubles shared by eggidentity apps: HTTP stubs, a self-cleaning temp directory, a fake signed-in user that matches the session claims, and a fake web host environment. Brings Microsoft.Extensions.TimeProvider.Testing for fake clocks. Test-framework agnostic.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Auth\EggIdentity.Auth.csproj" />
  </ItemGroup>

</Project>
